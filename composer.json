{
  "name": "solophp/http-client",
  "type": "library",
  "description": "PSR-18 HTTP client",
  "keywords": [
    "psr-18",
    "php",
    "http-client"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\HttpClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\HttpClient\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.10",
    "psr/http-client": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage",
    "cs": "phpcs --standard=PSR12 src/ tests/",
    "cs-fix": "phpcbf --standard=PSR12 src/ tests/",
    "phpstan": "phpstan analyse src --level=max"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
