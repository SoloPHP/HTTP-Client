{
  "name": "solophp/http-client",
  "type": "library",
  "description": "Immutable PSR-18 HTTP client built on Guzzle: fluent API, safe retries, origin-bound credentials and redacted logs.",
  "keywords": [
    "psr-18",
    "php",
    "http-client"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\HttpClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\HttpClient\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^8.3",
    "guzzlehttp/promises": "^3.1",
    "guzzlehttp/psr7": "^3.2",
    "psr/http-client": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.3.2"
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage",
    "cs": "phpcs --standard=PSR12 src/ tests/",
    "cs-fix": "phpcbf --standard=PSR12 src/ tests/",
    "phpstan": "phpstan analyse src --level=max",
    "check": [
      "@composer validate --strict",
      "@test",
      "@phpstan",
      "@cs"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
